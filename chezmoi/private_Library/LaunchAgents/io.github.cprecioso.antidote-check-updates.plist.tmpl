<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.cprecioso.antidote-check-updates</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{.chezmoi.config.destDir}}/.local/share/antidote/check-update</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>1</integer>
  </dict>
	<key>StandardOutPath</key>
	<string>{{.chezmoi.config.destDir}}/.local/state/antidote/check-update.log</string>
	<key>StandardErrorPath</key>
	<string>{{.chezmoi.config.destDir}}/.local/state/antidote/check-update.log</string>
</dict>
</plist>
