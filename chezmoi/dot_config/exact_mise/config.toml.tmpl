[tools]
cabal = "3.16.1.0"
deno = "latest"
node = "lts"
nub = "latest"
prettier = "latest"
"spm:cprecioso/swift-transcribe" = "v0.2.1"
uv = "latest"

{{- if .personal }}
tuist = "latest"
{{- end }}

[shell_alias]
ghostty = "open -a Ghostty"

[env]
TRY_DIR = "{{.chezmoi.config.destDir}}/Developer/Personal/try"
TRY_ACTIONS_FILE = "{{.chezmoi.config.destDir}}/.config/try/actions.bash"

[settings]
lockfile = true
minimum_release_age = "7d"
experimental = true

[settings.node]
corepack = true
npm_shim = false

[settings.github]
use_git_credentials = true
