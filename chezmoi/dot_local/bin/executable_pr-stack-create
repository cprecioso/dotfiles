#!/usr/bin/env bash

set -euo pipefail

repo=$(
	gh repo view --json nameWithOwner --jq '.nameWithOwner'
)

stack=$(
	{
		for pr_ref in "$@"; do
			gh pr view --json number "$pr_ref" --jq '.number'
		done
	} |
		jq -s '{"pull_requests": .}' |
		gh api -X POST "repos/$repo/stacks" --input - |
		jq -r '.number'
)

echo "Created stack $stack"
