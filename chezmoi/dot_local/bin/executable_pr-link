#!/usr/bin/env bash

set -euo pipefail

exit_with_usage() {
	echo "Usage: pr-link [--sponge] [--list] [--repo <owner/repo>]" >&2
	exit 1
}

read_cmd="cat"
list_prefix=""
gh_command=(gh)
api_repo="{owner}/{repo}"

while [[ $# -gt 0 ]]; do
	case "$1" in
	--sponge)
		read_cmd="sponge"
		;;
	--list)
		list_prefix="- "
		;;
	--repo)
		[[ $# -lt 2 ]] && exit_with_usage
		gh_command+=("--repo" "$2")
		api_repo="$2"
		shift
		;;
	*)
		echo "Unknown option: $1" >&2
		exit_with_usage
		;;
	esac
	shift
done

print_link() {
	local prefix="$1" ref="$2"
	"${gh_command[@]}" issue view --json url,title,number "$ref" |
		jq -r \
			--arg prefix "$prefix" \
			'$prefix + "[#" + (.number | tostring) + ": " + .title + "](" + .url + ")"'
}

# Stacks share the issue/PR numbering, so a number is a stack only when the
# stacks endpoint resolves it. Prints the stack's PR numbers, bottom to top.
stack_prs() {
	local number="${1#\#}"
	[[ "$number" =~ ^[0-9]+$ ]] || return 1
	gh api "/repos/${api_repo}/stacks/${number}" \
		--jq '.pull_requests[].number' 2>/dev/null
}

"${read_cmd}" |
	while read -r pr_ref; do
		if prs="$(stack_prs "$pr_ref")" && [[ -n "$prs" ]]; then
			index=1
			while read -r stacked_pr; do
				print_link "${index}. " "$stacked_pr"
				index=$((index + 1))
			done <<<"$prs"
		else
			print_link "$list_prefix" "$pr_ref"
		fi
	done
