#!/usr/bin/env bash

set -euo pipefail

exit_with_usage() {
  echo "Usage: worktree-install --src <dir> --dest <dir> --list <file>" >&2
  exit 1
}

src=""
dest=""
list=""

while [[ $# -gt 0 ]]; do
  case "$1" in
  --src | --dest | --list)
    [[ $# -lt 2 ]] && exit_with_usage
    declare "${1#--}=$2"
    shift
    ;;
  *)
    echo "Unknown option: $1" >&2
    exit_with_usage
    ;;
  esac
  shift
done

[[ -z "$src" || -z "$dest" || -z "$list" ]] && exit_with_usage
[[ -d "$src" ]] || {
  echo "Not a directory: $src" >&2
  exit 1
}
[[ -d "$dest" ]] || {
  echo "Not a directory: $dest" >&2
  exit 1
}
[[ -f "$list" ]] || {
  echo "Not a file: $list" >&2
  exit 1
}

list="$(cd "$(dirname "$list")" && pwd)/$(basename "$list")"

set -x

# Let git do the .gitignore-style matching. Tracked files are already in every
# worktree, so only untracked ones are listed.
git -C "$src" ls-files --others --ignored --exclude-from="$list" -z |
  while IFS= read -r -d '' path; do
    ditto "$src/$path" "$dest/$path"
  done
